# ============================================================================
#                              🐘 DATABASE
# ============================================================================
# ============================================================================
#                        ⚙️ Configuración General del Entorno
# ============================================================================
# Zona horaria utilizada dentro del contenedor
TZ=America/Bogota

# ============================================================================
# 🛢️ CONFIGURACIÓN DE PRODUCCIÓN - docker-compose-postgresql.yml
# ============================================================================
# 👤 Usuario de PostgreSQL
POSTGRES_USER=tu_usuario
# 🔐 Contraseña de acceso
POSTGRES_PASSWORD=tu_password
# 🗄️  Base de datos principal
POSTGRES_DB=hic_cibus

# ============================================================================
# 🔧 CONFIGURACIÓN DE DESARROLLO - docker-compose-postgresql-dev.yml
# ============================================================================
# 👤 Usuario de PostgreSQL
POSTGRES_USER_DEV=admin
# 🔐 Contraseña de acceso
POSTGRES_PASSWORD_DEV=admin
# 🗄️  Base de datos principal
POSTGRES_DB_DEV=hic_cibus_dev