# ============================================================================
#                                🌐 .env File (v0.1.0)
# ============================================================================
# Este archivo define las variables de entorno necesarias para la
# configuración del servicio PostgreSQL mediante Docker Compose
# en ENTORNO DE PRODUCCIÓN.
#
# 🚀 NOTA IMPORTANTE:
# Antes de iniciar este servicio, asegúrate de que el contenedor del
# proxy inverso (Traefik) esté activo, ya que es el primer contenedor
# que debe iniciarse para habilitar el enrutamiento de peticiones.
#
# 🌍 DOMINIOS Y ENTORNOS:
# 1. En este entorno, deberás utilizar un dominio real configurado
#    correctamente en tu proveedor de DNS.
#
# ⚠️ El dominio "hic-cibus.com" es privado y pertenece al proyecto hic-Cibus 🦋.
#    No está disponible para uso externo. Usa exclusivamente tu propio dominio.
# ============================================================================

# ============================================================================
#                        ⚙️ Configuración General del Entorno
# ============================================================================
# Zona horaria utilizada dentro del contenedor
TZ=America/Bogota

# ============================================================================
# 🛢️ CONFIGURACIÓN DE PostgreSQL - docker-compose-postgresql.yml
# ============================================================================
# 👤 Usuario de PostgreSQL
POSTGRES_USER=tu_usuario
# 🔐 Contraseña de acceso
POSTGRES_PASSWORD=tu_contraseña
# 🗄️  Base de datos principal
POSTGRES_DB=hic_cibus

# ============================================================================
# 🛡️ NOTAS DE SEGURIDAD
# ============================================================================
# - Nunca compartas este archivo ni lo subas a repositorios públicos.
# - Cambia todas las credenciales por valores seguros antes del despliegue.
# - Realiza copias de seguridad seguras de este archivo en entornos protegidos.
# ============================================================================