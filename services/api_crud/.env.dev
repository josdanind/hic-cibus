# ==========================================
# 💾 CODE: TLALOC_CRUD-DEV-ENV_FILE
# 📌 VERSIÓN: v0.1.0
# 📦 DESCRIPCIÓN:
#       Variables de entorno para la ApiCRUD de Tlaloc
#       en entorno de desarrollo.
# 🧠 LÓGICA:
#       - docker-compose-crud-dev.yml
#       - user_auth_db (autenticación de usuarios)
# 📅 FECHA: 2025-09-10
# ==========================================

# ============================================================================
#                                🌐 .env File
# ============================================================================
# Este archivo define las variables de entorno necesarias para la
# configuración de la ApiCRUD mediante Docker Compose
# en ENTORNO DE DESARROLLO.
#
# 🚀 NOTA IMPORTANTE:
# Antes de iniciar este servicio, asegúrate de que el contenedor del
# proxy inverso (Traefik) esté activo, ya que es el primer contenedor
# que debe habilitar el enrutamiento de peticiones.
#
# 🌍 DOMINIOS Y ENTORNOS:
# 1. En entornos de desarrollo, el dominio `dev.hic-cibus.com` será accesible
#    únicamente de forma local, gracias a la entrada correspondiente en el
#    archivo de hosts del sistema operativo:
#
#    - Linux: /etc/hosts
#    - Windows: C:\Windows\System32\drivers\etc\hosts
#
#    127.0.0.1 dev.hic-cibus.com
#
# 2. Si deseas usar un dominio personalizado, simplemente reemplaza todas las
#    referencias a "hic-cibus.com" por el nombre de dominio que elijas.
#    Asegúrate de agregar también la entrada correspondiente en el archivo de
#    hosts.
# ============================================================================

# ============================================================================
#                        ⚙️ Configuración General del Entorno
# ============================================================================
# Zona horaria utilizada dentro del contenedor
TZ=America/Bogota

# ============================================================================
# 🛢️ CONFIGURACIÓN de la ApiCRUD - docker-compose-crud-dev.yml
# ============================================================================
# 🌐 Dominio de FastAPI en desarrollo
API_DOMAIN=dev.hic-cibus.com
# 🚪 Puerto interno de FastAPI
PORT=8000
# 🚩 Entorno de la aplicación
ENVIRONMENT=development

# ============================================================================
# 🔑 Autenticación JWT
# ============================================================================
SECRET_KEY=THddshSn62LGVWFpWo/cNvsgYE1/W76kFdJ/Y16eGoU=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=30
ACCESS_TOKEN_EXPIRE_MINUTES=15

# 📌 Puedes generar una nueva SECRET_KEY con:
# openssl rand -base64 32

# ============================================================================
# 🗄️ Base de Datos - Gestión de usuarios CRUD
# ============================================================================
# 🔑 Credenciales para conexión remota a la base de datos
CRUD_USERS_DB_HOST=postgresql-dev
CRUD_USERS_DB_PORT=5432
CRUD_USERS_DB_USER=admin
CRUD_USERS_DB_PASSWORD=admin
CRUD_USERS_DB_NAME=crud_users_db

# 👤 Usuario predeterminado para la API CRUD
CRUD_USER_TELEGRAM_USERNAME=admin
CRUD_USER_FIRST_NAME=admin
CRUD_USER_LAST_NAME=admin
CRUD_USER_MOBILE_PHONE=+573001234567
CRUD_USER_EMAIL=admin@hic-cibus.com
CRUD_USER_PASSWORD=admin

# ============================================================================
# 🗄️ Base de Datos - Gestión de usuarios MQTT
# ============================================================================
MQTT_USERS_DB_HOST=postgresql-dev
MQTT_USERS_DB_PORT=5432
MQTT_USERS_DB_USER=admin
MQTT_USERS_DB_PASSWORD=admin
MQTT_USERS_DB_NAME=mqtt_users_db

# 👤 Usuario MQTT Predeterminado
MQTT_USER_USERNAME=admin
MQTT_USER_PASSWORD=admin
BCRYPT_ROUNDS=4

# ============================================================================
# 🗄️ Base de Datos - Lógica de Tlaloc
# ============================================================================
TLALOC_DB_HOST=postgresql-dev
TLALOC_DB_PORT=5432
TLALOC_DB_USER=admin
TLALOC_DB_PASSWORD=admin
TLALOC_DB_NAME=tlaloc_db

# 📌 NOTA:
# En producción, asegúrate de que el dominio está correctamente configurado en tu DNS.
# Mantén las credenciales en secreto para garantizar la seguridad del sistema.
