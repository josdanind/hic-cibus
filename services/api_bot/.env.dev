# ==========================================
# 💾 CODE: TLALOC_BOT-DEV-ENV_FILE
# 📌 VERSIÓN: v0.1.0
# 📦 DESCRIPCIÓN:
#       Variables de entorno para el bot Tlaloc
#       en entorno de desarrollo.
# 🧠 LÓGICA:
#       - docker-compose-api_bot-dev.yml
# 📅 FECHA: 2025-09-10
# ==========================================

# ============================================================================
#                                🌐 .env File
# ============================================================================
# Este archivo define las variables de entorno necesarias para la
# configuración el servicio del bot Tlaloc, específicamente
# en ENTORNO DE DESARROLLO.
#
# 🚀 NOTA IMPORTANTE:
# Antes de iniciar este servicio, asegúrate de que el contenedor del
# proxy inverso (Traefik) esté activo, ya que es el primer contenedor
# que debe habilitar el enrutamiento de peticiones.
#
# 🌍 DOMINIOS Y ENTORNOS:
# 1. En entornos de desarrollo, el dominio `tlaloc-dev.hic-cibus.com` será
#    accesible únicamente de forma local, gracias a la entrada correspondiente
#    en el archivo de hosts del sistema operativo:
#
#    - Linux: /etc/hosts
#    - Windows: C:\Windows\System32\drivers\etc\hosts
#
#    127.0.0.1 tlaloc-dev.hic-cibus.com
#
# 2. Si deseas usar un dominio personalizado, simplemente reemplaza todas las
#    referencias a "tlaloc-dev.hic-cibus.com" por el nombre de dominio que elijas.
#    Asegúrate de agregar también la entrada correspondiente en el archivo de
#    hosts.
# ============================================================================

# ============================================================================
#                        ⚙️ Configuración General del Entorno
# ============================================================================
# Zona horaria utilizada dentro del contenedor
TZ=America/Bogota
# 🚩 Entorno de la aplicación
DEVELOPMENT_MODE=true

# ============================================================================
# 🤖 CONFIGURACIÓN del Bot - docker-compose-api_bot-dev.yml
# ============================================================================
# ---------------------------------------------------------------------------
# API-CRUD para Tlaloc Bot
# ---------------------------------------------------------------------------
# URL base para las peticiones a la API-CRUD
API_CRUD_URL=http://api_crud-dev:8000/bots
# Credenciales de acceso a la API-CRUD
TELEGRAM_BOT_NAME=tlaloc-pilot
TELEGRAM_BOT_PASSWORD=botPassword
# ---------------------------------------------------------------------------
# Tokens de acceso y configuración del Bot
# ---------------------------------------------------------------------------
# Token suministrado por BotFather en Telegram
TELEGRAM_BOT_TOKEN=botFatherToken
# Token secreto para validar las peticiones entrantes de Telegram
TELEGRAM_SECRET_TOKEN=tokenSecret
# Ngrok Token
NGROK_TOKEN=ngrokToken

# ============================================================================
# 🛢️ CONFIGURACIÓN VALKEY - docker-compose-api_bot-dev.yml
# ============================================================================
VALKEY_HOST=valkey
VALKEY_PORT=6379
VALKEY_PASSWORD=valkeyPassword